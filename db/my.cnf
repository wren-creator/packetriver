# Packet River MariaDB config, mounted at /etc/mysql/conf.d/packetriver.cnf.
# Lifted from widgetorium/db/my.cnf: deliberate loosenesses that keep injection
# payloads working and set up later file-read lessons.

[mysqld]
# Empty secure_file_priv lets LOAD_FILE() / INTO OUTFILE touch any path the
# server user can reach (used by later phases).
secure_file_priv=""
# LOAD DATA LOCAL INFILE from the client side.
local_infile=1
# No sql_mode => no STRICT_TRANS_TABLES, so coerced injected values keep working.
sql_mode=""
# Keep the general log off, but easy to switch on for a query-logging demo.
general_log=0
