# Packet River town configuration.
# Copy to .env (setup.sh does this for you) and edit if you need to.
# Every value below is the FLAT, vulnerable-by-default setting so the attack
# half of the game works. Run ./start.sh --segmented (Phase 4+) to apply the
# whole hardened topology at once, or flip individual toggles to 0 here.

# --- game core ---
# Simulation tick, seconds. Lower = snappier map, more CPU.
TICK_SECONDS=1.0
# CashApp cashtag the "enjoying this?" banner points at (without the leading
# $, the UI adds it). Rendered as a plain link, no third-party widget or tracker.
DONATION_CASHAPP=britleywren
# PKT_LIGHT=1 skips the player/attacker box and the IDS to save RAM. The town
# still runs; you attack it from your own shell instead.
PKT_LIGHT=0
# Signs the scoreboard session cookie. Change it for anything but local play.
SESSION_SECRET=packet-river-dev-secret

# --- web tier weaknesses (Phase 1 / Phase 3) ---
# VERBOSE_ERRORS=1 leaks SQL, stack traces, and framework banners.
VERBOSE_ERRORS=1
# DEFAULT_CREDS=1 leaves shop admin, HMI, and console logins at their factory
# passwords (admin/admin, openplc/openplc, maint/maint).
DEFAULT_CREDS=1
# PLANT_GIT=1 serves an exposed .git directory with a secret in its history.
PLANT_GIT=1
# WEAK_SESSIONS=1 mints predictable session tokens instead of random ones.
WEAK_SESSIONS=1

# --- OT weaknesses (Phase 2 / Phase 4) ---
# MODBUS_WRITE_OPEN=1 accepts coil/register writes from any source address.
MODBUS_WRITE_OPEN=1
# S7_NO_PASSWORD=1 lets the substation RTU accept stop-CPU / breaker writes
# with no authentication.
S7_NO_PASSWORD=1
# MQTT_OPEN=1 leaves the traffic-light topics (pkt/traffic/#) world-writable.
MQTT_OPEN=1
# The traffic controller's "engineering mode" PIN and the rail switch console's
# default credentials. The segmented build rotates all three.
TRAFFIC_ENG_PIN=0000
RAIL_CONSOLE_USER=maint
RAIL_CONSOLE_PASS=maint
# The rail engineer's operator account (Phase 5b): reused on the SOHO crew
# portal the packet-capture lane sniffs, and valid on the rail console.
RAIL_CREW_USER=rse.kmiller
RAIL_CREW_PASS=Sw1tchboard!

# --- Phase 5 network-attack lanes ---
# The Diner guest-Wi-Fi rewards portal credential (cleartext on lan-net).
DINER_PORTAL_PASS=Rewards2026
# The home router's admin login (Phase 5b). Consumer default; the hardened
# build rotates it.
SOHO_ADMIN_PASS=admin

# The field-plc SCADA HMI logins are per-plant, minted by `scoring` at boot,
# and rotated at Alert L2 (their current values sit on field-plc's
# /ops/handover.txt). HMI_USER/HMI_PASS below are only the fallback when the
# credential volume isn't mounted. PKT_CRED_ROTATE_MIN would add wall-clock
# rotation - not wired yet (roadmap); leave at 0.
HMI_USER=operator
HMI_PASS=operator
PKT_CRED_ROTATE_MIN=0

# --- monitoring (Phase 4) ---
# IDS_ENABLED=0 keeps Suricata off until the segmented build.
IDS_ENABLED=0

# --- easter-egg hints ---
# PKT_EGGS: off (default) | subtle | obvious. Help hidden as in-world artifacts
# (a robots.txt, a README.old, an HTML comment, a DNS TXT record, /hints on the
# map). Fragments only, never a working command. See eggs/REGISTRY.md.
PKT_EGGS=off

# --- timed events ---
# PKT_EVENTS: off | calm (default, 5-9 min gaps) | lively (2-4 min). A news
# crew (loud incidents on camera hit the Alert meter 1.6x harder), a state
# inspector (an incident during the visit = citation + heat), and a Founder's
# Day parade (a signal hijack during the parade racks crashes ~4x faster).
PKT_EVENTS=calm
