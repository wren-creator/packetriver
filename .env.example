# Packet River town configuration.
# Copy to .env (setup.sh does this for you) and edit if you need to.
# Every value below is the FLAT, vulnerable-by-default setting so the attack
# half of the game works. Run ./start.sh --segmented (Phase 4+) to apply the
# whole hardened topology at once, or flip individual toggles to 0 here.

# --- game core ---
# Simulation tick, seconds. Lower = snappier map, more CPU.
TICK_SECONDS=1.0
# CashApp cashtag the "enjoying this?" banner points at (without the leading
# $, the UI adds it). Rendered as a plain link, no third-party widget or tracker.
DONATION_CASHAPP=britleywren
# PKT_LIGHT=1 skips the player/attacker box and the IDS to save RAM. The town
# still runs; you attack it from your own shell instead.
PKT_LIGHT=0

# --- web tier weaknesses (Phase 1 / Phase 3) ---
# VERBOSE_ERRORS=1 leaks SQL, stack traces, and framework banners.
VERBOSE_ERRORS=1
# DEFAULT_CREDS=1 leaves shop admin, HMI, and console logins at their factory
# passwords (admin/admin, openplc/openplc, maint/maint).
DEFAULT_CREDS=1
# PLANT_GIT=1 serves an exposed .git directory with a secret in its history.
PLANT_GIT=1
# WEAK_SESSIONS=1 mints predictable session tokens instead of random ones.
WEAK_SESSIONS=1

# --- OT weaknesses (Phase 2 / Phase 4) ---
# MODBUS_WRITE_OPEN=1 accepts coil/register writes from any source address.
MODBUS_WRITE_OPEN=1
# S7_NO_PASSWORD=1 lets the substation RTU accept stop-CPU / breaker writes
# with no authentication.
S7_NO_PASSWORD=1
# MQTT_OPEN=1 leaves the traffic-light topics (pkt/traffic/#) world-writable.
MQTT_OPEN=1

# --- monitoring (Phase 4) ---
# IDS_ENABLED=0 keeps Suricata off until the segmented build.
IDS_ENABLED=0
